# Copy to .env (gitignored) and fill in. docker compose passes these to the
# container; see README for what each one does.
PUBLIC_URL=https://yogos.example.com
# Behind the Caddy service: client addresses come from X-Forwarded-For.
TRUST_PROXY=1
# The host part of PUBLIC_URL, for the Caddy service in docker-compose.
YOGOS_HOST=yogos.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only let members of this Discord server sign in (optional).
DISCORD_GUILD_ID=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated Discord user ids.
ADMIN_DISCORD_IDS=
CHECK_LIMIT=10
DISCONNECT_GRACE_SECONDS=120
READY_TIMEOUT_SECONDS=180
